// Nebulosa: 3120 luci su 26 gusci sferici, i bassi al centro e gli acuti
// in superficie. Ogni luce ha una direzione fissa (spirale aurea, sfasata
// per guscio): a muoversi è solo il raggio, spinto dall'energia della sua
// banda e dalle onde d'urto dei colpi. La camera gira e i bassi la
// avvicinano; la profondità dà la luce, ed è quella a far leggere una sfera.
//
// Una simulazione ad agenti ricalcolata a ogni passo da `values`: 140 yaw,
// 141 pitch, 142 distanza, 143 quante onde, da 144 fronte e ampiezza.

const SHELLS: i32 = 26;
const PER_SHELL: i32 = 120;
const R_MIN: f32 = 0.22;
const R_MAX: f32 = 0.82;
const PULSE: f32 = 0.24;
const FOCAL: f32 = 2.4;
const SHOCK_AMP: f32 = 0.32;
const SHOCK_WIDTH: f32 = 0.16;

// Lo spettro di un canale in t (0..1), tra due bande.
fn sample(right: bool, t: f32) -> f32 {
    let f = clamp(t, 0.0, 1.0) * 63.0;
    let i = i32(floor(f));
    let j = min(i + 1, 63);
    var base = 0;
    if (right) {
        base = 64;
    }
    let a = band(base + i);
    let b = band(base + j);
    return a + (b - a) * (f - floor(f));
}

fn agent(i: i32, me: Agent) -> Agent {
    var a = me;
    let s = i / PER_SHELL;
    let k = i - s * PER_SHELL;
    let t = f32(s) / f32(SHELLS - 1);
    // Angolo aureo: punti quasi uniformi sulla sfera, senza addensarsi ai poli.
    let golden = PI * (3.0 - sqrt(5.0));
    let y = 1.0 - 2.0 * (f32(k) + 0.5) / f32(PER_SHELL);
    let rad = sqrt(max(1.0 - y * y, 0.0));
    let th = f32(k) * golden + f32(s) * 0.61;
    let d = vec3<f32>(cos(th) * rad, y, sin(th) * rad);

    let e = sample(d.x >= 0.0, t);
    var bump = 0.0;
    let shocks = i32(value(143));
    for (var w = 0; w < shocks; w = w + 1) {
        let z = (t - value(144 + w * 2)) / SHOCK_WIDTH;
        bump = bump + value(145 + w * 2) * exp(-z * z);
    }
    let r = R_MIN + t * (R_MAX - R_MIN) + e * PULSE + bump * SHOCK_AMP;

    // Yaw attorno a Y, poi pitch attorno a X.
    let yaw = value(140);
    let pitch = value(141);
    let dist = value(142);
    let q = d * r;
    let x1 = q.x * cos(yaw) + q.z * sin(yaw);
    let z1 = -q.x * sin(yaw) + q.z * cos(yaw);
    let p = vec3<f32>(x1, q.y * cos(pitch) - z1 * sin(pitch), q.y * sin(pitch) + z1 * cos(pitch));
    let persp = FOCAL / max(dist + p.z, 0.5);
    let s0 = FOCAL / max(dist, 0.5);

    // Sullo schermo: unità di metà altezza dal centro, y verso l'alto.
    let size = shader.size;
    a.at = vec2<f32>(size.x * 0.5 + p.x * persp * size.y * 0.5, size.y * 0.5 - p.y * persp * size.y * 0.5);
    a.velocity = vec2<f32>(0.0);
    let depth = clamp(persp / s0, 0.0, 1.6);
    let alpha = clamp(depth * depth * (0.12 + e * 0.9 + bump * 0.7), 0.0, 1.0);
    a.data = vec4<f32>(mix(col_a(), col_b(), t), alpha);
    return a;
}

fn shade(p: vec2<f32>) -> vec4<f32> {
    return vec4<f32>(0.0);
}
